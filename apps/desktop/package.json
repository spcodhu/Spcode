    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "electron-updater": "^6.8.9",
    "katex": "^0.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-qr-code": "^2.0.15",
