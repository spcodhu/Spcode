# Super Agent 阶段一环境变量样例（只含空值，不包含任何真实凭据）
# 在启动 Electron 或 apps/control-plane 的同一环境中设置。不要把填好的版本提交到 Git。

# 总开关；默认关闭。开启后才会自动计划、派工、接收群消息和发送摘要。
SPCODE_SUPERAGENT_ENABLED=1

# 默认仓库 spcodhu/Spcode 的本地只读来源；Worker 只使用 mirror/worktree，不修改此目录。
SPCODE_SUPERAGENT_REPO_PATH=/absolute/path/to/Spcode

# 可选：多仓库本地来源映射（JSON 单行）。未列出的仓库使用公开 GitHub URL。
SPCODE_SUPERAGENT_REPOS={"spcodhu/Spcode":"/absolute/path/to/Spcode"}

# GitHub REST 只读凭据。私有仓库建议使用最小只读权限的 fine-grained token。
SPCODE_GITHUB_TOKEN=

# 每日/手动摘要目标。多个仓库用逗号分隔；未设置时默认 spcodhu/Spcode。
SPCODE_SUPERAGENT_DIGEST_REPOS=spcodhu/Spcode
SPCODE_SUPERAGENT_DIGEST_CHAT_ID=

# 飞书应用与当前机器人 open_id。appSecret 只在控制面进程内使用，绝不下发 Worker。
SPCODE_FEISHU_APP_ID=
SPCODE_FEISHU_APP_SECRET=
SPCODE_FEISHU_BOT_OPEN_ID=

# 允许创建 Trigger 的群和授权操作人 open_id，逗号分隔。
SPCODE_SUPERAGENT_ALLOWED_CHATS=
SPCODE_SUPERAGENT_AUTHORIZED_OPERATORS=

# 可选：本机出网代理，支持 http:// 或 https:// URL；不要在此写入代理账号密码。
# HTTPS_PROXY=http://127.0.0.1:7890

# 模型继续使用 ~/.spcode/agent/auth.json 与现有模型目录。
# 也可通过对应供应商的 *_API_KEY 环境变量注入；Worker 只继承模型相关白名单环境。

# 可选：Watchdog 默认开启；设为 0 可关闭（不修改代码，只报告 Finding）。
# SPCODE_WATCHDOG=1

# 仅测试使用：独立 Fake Node Worker，绝不用于生产验收真实模型。
# SPCODE_SUPERAGENT_FAKE_WORKER=1
# SPCODE_FAKE_WORKER_DELAY=1200
# SPCODE_TEST_AFTER_COMMIT=1
# SPCODE_TEST_AFTER_OUTBOX_SEND=1
