# Super Agent 阶段二环境变量样例（不要提交填好的真实密钥）

# 控制面/公网入口
SPCODE_CONTROL_PLANE_URL=http://127.0.0.1:47831
SPCODE_PUBLIC_URL=https://agent.example.com
SPCODE_TRUSTED_HOSTS=agent.example.com
SPCODE_TRUSTED_ORIGINS=https://agent.example.com
SPCODE_TRUST_PROXY=1
SPCODE_REQUIRE_TLS=1
SPCODE_RATE_LIMIT_PER_MINUTE=120

# OIDC：生产优先 JWKS；sharedSecret 仅用于本地 HS256 联调，不要用于公网生产。
SPCODE_OIDC_ISSUER=https://issuer.example.com
SPCODE_OIDC_AUDIENCE=spcode-control
SPCODE_OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# SPCODE_OIDC_SHARED_SECRET=local-test-only-change-me

# 仅 Electron 连接外部 Router 时使用；OIDC token 仅在本地启动时经 fragment 换取 Cookie。
# SPCODE_CONTROL_PLANE_BOOTSTRAP_TOKEN=

# PostgreSQL：生产连接串写密码时只在受控环境注入，不写日志/配置/备份。
SPCODE_POSTGRES_URL=postgresql://spcode:change-me@127.0.0.1:5432/spcode

# Worker Node：首次配对使用本地 runtime.json 中的 serviceToken，或公网 admin 的配对流程。
SPCODE_WORKER_PAIR_TOKEN=
SPCODE_WORKER_NODE_NAME=worker-local-1
SPCODE_WORKER_NODE_DATA_DIR=/absolute/path/to/worker-node-data
SPCODE_WORKER_NODE_CAPACITY=1
SPCODE_WORKER_NODE_POLL_MS=250
SPCODE_WORKER_REPO_PATH=/absolute/path/to/Spcode

# Effect Executor：不要与 Worker Node token 混用。
SPCODE_EXECUTOR_TOKEN=
SPCODE_EXECUTOR_ID=effect-executor-1
SPCODE_EXECUTOR_POLL_MS=250

# Artifact S3/OSS 兼容对象存储；不设则使用本地受管磁盘。
# SPCODE_ARTIFACT_S3_BUCKET=spcode-artifacts
# SPCODE_ARTIFACT_S3_ENDPOINT=https://s3.example.com
# SPCODE_ARTIFACT_S3_REGION=us-east-1
# SPCODE_ARTIFACT_S3_ACCESS_KEY_ID=
# SPCODE_ARTIFACT_S3_SECRET_ACCESS_KEY=
# SPCODE_ARTIFACT_S3_SESSION_TOKEN=
# SPCODE_ARTIFACT_S3_FORCE_PATH_STYLE=1
# SPCODE_ARTIFACT_S3_PREFIX=spcode/artifacts/

# Provider 资源白名单/凭据（按需要使用，绝不发给 Worker）。
# SPCODE_NGINX_ROOT=/etc/nginx
# SPCODE_DEPLOYMENT_ROOT=/absolute/path/to/deploy
# SPCODE_CLOUDFLARE_API_TOKEN=
# SPCODE_GITHUB_TOKEN=

# 迁移工具
# SPCODE_MIGRATE_DIRECTION=export
# SPCODE_MIGRATE_FROM_SQLITE=/absolute/path/to/control.sqlite
# SPCODE_MIGRATE_BACKUP=/absolute/path/to/control-backup.json
# SPCODE_MIGRATE_ARTIFACT_DIR=/absolute/path/to/artifacts

# 仅测试：独立 Fake Worker / 嵌入式 PG / s3rver，不要用于生产真实模型或云资源验收。
# SPCODE_SUPERAGENT_FAKE_WORKER=1
# SPCODE_FAKE_WORKER_DELAY=250
# SPCODE_TEST_AFTER_COMMIT=1
# SPCODE_TEST_AFTER_OUTBOX_SEND=1
