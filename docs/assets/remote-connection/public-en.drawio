        <mxCell id="9" value="WSS ciphertext" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;strokeColor=#426580;strokeWidth=2;fontSize=16;fontColor=#374151;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="10" value="WSS ciphertext" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;strokeColor=#2F6F5E;strokeWidth=2;fontSize=16;fontColor=#374151;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;div&gt;&lt;b&gt;Pairing is transferred out of band; the relay cannot decrypt business traffic&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;The relay sees channel IDs, deviceId, timing, and traffic metadata; its offline queue is memory-only&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#D7D9D6;fontColor=#4B5563;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
