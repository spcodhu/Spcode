     }
     rules.push(...renderRule('deny', ['file-write-unlink', 'file-write-create'], moveFilters, logTag));
+    // Dependency-owned dotfiles are not attacker-controlled workspace configuration.
+    rules.push(...generateNodeModulesDenyExemptionRules(logTag));
     return rules;
