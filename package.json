{
  "name": "spcodhu-harness",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @spcode/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/pre-push",
    "review:context": "node scripts/review-context.mjs",
    "review:record": "node scripts/review-record.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "dist": "pnpm --filter @spcode/desktop dist"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "22.20.5",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "patchedDependencies": {
      "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch",
      "@anthropic-ai/sandbox-runtime@0.0.79": "patches/anthropic-ai-sandbox-runtime@0.0.79.patch",
      "@earendil-works/pi-ai@1.5.2": "patches/earendil-works-pi-ai@1.5.2.patch"
    }
  }
}
